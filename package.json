{
  "name": "web-push",
  "version": "1.0.0",
  "main": "app.ts",
  "private": true,
  "scripts": {
    "lint": "eslint './src/**/*.{ts,tsx}'",
    "dev": "ts-node-dev --respawn --transpile-only -r ./src/register-alias.ts src/app.ts",
    "start": "node -r ./dist/register-alias.js dist/app.js",
    "start:worker": "node -r ./dist/register-alias.js dist/bull-worker.js",
    "build": "npm run lint && tsc"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "body-parser": "^2.2.0",
    "bull": "^4.16.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jwk-to-pem": "^2.0.7",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.0",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "redis": "^4.7.0",
    "sequelize": "^6.37.7",
    "web-push": "^3.6.7",
    "module-alias": "^2.2.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/jwk-to-pem": "^2.0.3",
    "@types/module-alias": "^2.0.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.1",
    "@types/node-cron": "^3.0.11",
    "@types/sequelize": "^4.28.20",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3",
    "eslint": "^9.26.0"
  }
}